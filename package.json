{
  "name": "vplatform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "dev": "pnpm dev:apps",
    "dev:apps": "pnpm --filter @vplatform/identity-config build && pnpm --filter @vplatform/oidc-auth build && pnpm --filter @vplatform/shared-core-api build && pnpm --filter @vplatform/office-api build && node scripts/dev/start-platform-apps.mjs",
    "dev:all": "pnpm --filter @vplatform/identity-config build && pnpm --parallel --stream -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:realm && pnpm -r test",
    "test:realm": "node --test infrastructure/keycloak/realm.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infrastructure/compose/development.yml up -d",
    "infra:down": "docker compose -f infrastructure/compose/development.yml down",
    "shared-core-db:up": "docker compose -f infrastructure/compose/shared-core-database-development.yml up -d",
    "shared-core-db:down": "docker compose -f infrastructure/compose/shared-core-database-development.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
