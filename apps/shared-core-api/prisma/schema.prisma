/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_firm_applications {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String       @db.Uuid
  firm_id        String       @db.Uuid
  application_id String       @db.Uuid
  valid_from     DateTime?    @db.Date
  valid_to       DateTime?    @db.Date
  is_active      Boolean      @default(true)
  metadata       Json         @default("{}")
  row_version    BigInt       @default(1)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  firms          firms        @relation(fields: [firm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, firm_id, application_id], map: "user_firm_applications_user_firm_application_key")
  @@index([application_id], map: "idx_user_firm_applications_application")
  @@index([firm_id], map: "idx_user_firm_applications_firm")
}

model user_firm_roles {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String                       @db.Uuid
  firm_id                    String                       @db.Uuid
  role_id                    String                       @db.Uuid
