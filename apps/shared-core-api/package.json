{
  "name": "@vplatform/shared-core-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "prisma:generate": "env XDG_CACHE_HOME=../../.cache prisma generate --schema prisma/schema.prisma",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @vplatform/oidc-auth build",
    "test": "vitest run",
    "test:authorization:integration": "vitest run src/authorization/authorization.integration.spec.ts",
    "test:firms:integration": "vitest run src/firms/firm-writer.integration.spec.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "@vplatform/identity-config": "workspace:*",
    "@vplatform/oidc-auth": "workspace:*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.9",
    "jose": "^6.1.3",
    "prisma": "6.19.1"
  }
}
