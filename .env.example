# Database URLs are reserved for their owning backend process. These placeholders
# are intentionally not consumed by the Phase 1 scaffold.
# Runtime URL only. Migration commands must use a separately supplied owner URL.
SHARED_CORE_DATABASE_URL=postgresql://shared_core_api:change-me@postgres:5432/shared_core
SHARED_CORE_MIGRATION_DATABASE_URL=postgresql://shared_core_user:change-me@postgres:5432/shared_core
# Firm commands use a separate narrow DML role. Supply a real value only to
# shared-core-api through local/deployment secret management.
SHARED_CORE_FIRM_WRITER_DATABASE_URL=postgresql://shared_core_firm_writer:change-me@postgres:5432/shared_core
OFFICE_DATABASE_URL=postgresql://vplatform_office_app:change-me@postgres:5432/office
ACCOUNTING_DATABASE_URL=postgresql://vplatform_accounting_app:change-me@postgres:5432/accounting

# Shared development infrastructure
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-for-local-development
MINIO_BUCKET_DOCUMENTS=vplatform-documents-dev

# Keycloak development bootstrap. Change these in a local .env.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-for-local-development

# Server-side OIDC configuration. Client IDs and audiences are identifiers,
# not secrets. No client secrets are used in Phase 2A.
OIDC_ISSUER_URL=http://localhost:8080/realms/vplatform
OIDC_SHARED_CORE_API_CLIENT_ID=shared-core-api
OIDC_SHARED_CORE_API_AUDIENCE=shared-core-api
OIDC_SHARED_CORE_API_SIGNING_ALGORITHM=RS256
OIDC_CLOCK_TOLERANCE_SECONDS=5
OIDC_OFFICE_API_CLIENT_ID=office-api
OIDC_OFFICE_API_AUDIENCE=office-api
OIDC_OFFICE_API_SIGNING_ALGORITHM=RS256
OIDC_ACCOUNTING_API_CLIENT_ID=accounting-api
OIDC_ACCOUNTING_API_AUDIENCE=accounting-api

# Browser-safe OIDC configuration. Accounting URLs are usable only from the
# protected development network; these values do not relax that boundary.
# Office Web is a server-side OIDC/BFF client. Generate a unique 32+ character
# session secret locally; never expose it through NEXT_PUBLIC variables.
OFFICE_OIDC_ISSUER_URL=http://localhost:8080/realms/vplatform
OFFICE_OIDC_CLIENT_ID=office-web
OFFICE_WEB_BASE_URL=http://localhost:3000
OFFICE_WEB_SESSION_SECRET=change-me-to-a-random-secret-at-least-32-characters
OFFICE_API_URL=http://localhost:3002
OFFICE_WEB_ORIGIN=http://localhost:3000
SHARED_CORE_API_URL=http://localhost:3001
NEXT_PUBLIC_ACCOUNTING_OIDC_ISSUER_URL=http://localhost:8080/realms/vplatform
NEXT_PUBLIC_ACCOUNTING_OIDC_CLIENT_ID=accounting-web
NEXT_PUBLIC_ACCOUNTING_OIDC_AUDIENCE=accounting-api

# Application ports
SHARED_CORE_API_PORT=3001
OFFICE_API_PORT=3002
OFFICE_WEB_PORT=3000
ACCOUNTING_API_PORT=3102
ACCOUNTING_WEB_PORT=3100
