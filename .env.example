# Database URLs are reserved for their owning backend process. These placeholders
# are intentionally not consumed by the Phase 1 scaffold.
SHARED_CORE_DATABASE_URL=postgresql://vplatform_shared_core_app:change-me@postgres:5432/shared_core
OFFICE_DATABASE_URL=postgresql://vplatform_office_app:change-me@postgres:5432/office
ACCOUNTING_DATABASE_URL=postgresql://vplatform_accounting_app:change-me@postgres:5432/accounting

# Shared development infrastructure
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-for-local-development
MINIO_BUCKET_DOCUMENTS=vplatform-documents-dev

# Keycloak/OIDC placeholders
OIDC_ISSUER_URL=http://localhost:8080/realms/vplatform
OIDC_SHARED_CORE_CLIENT_ID=vplatform-shared-core-api
OIDC_OFFICE_CLIENT_ID=vplatform-office
OIDC_ACCOUNTING_CLIENT_ID=vplatform-accounting

# Application ports
SHARED_CORE_API_PORT=3001
OFFICE_API_PORT=3002
OFFICE_WEB_PORT=3000
ACCOUNTING_API_PORT=3102
ACCOUNTING_WEB_PORT=3100
